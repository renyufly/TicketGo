APP_ENV=development
HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=5s
HTTP_READ_HEADER_TIMEOUT=2s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=3s
HTTP_SHUTDOWN_TIMEOUT=10s

POSTGRES_DB=ticketgo
POSTGRES_USER=ticketgo
POSTGRES_PASSWORD=ticketgo_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgres://ticketgo:ticketgo_local_password@localhost:5432/ticketgo?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_QUERY_TIMEOUT=3s

# Replace in every environment. At least 32 characters; never commit a real secret.
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL=24h
